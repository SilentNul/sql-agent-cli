{
  "servers": [
    {
      "name": "fetch",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-fetch"
      ]
    },
    {
      "name": "filesystem",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    {
      "name": "time",
      "transport": "stdio",
      "command": "python",
      "args": [
        "-m",
        "mcp_server_time"
      ]
    },
    {
      "name": "playwright",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--viewport-size",
        "1440x900"
      ]
    }
  ]
}